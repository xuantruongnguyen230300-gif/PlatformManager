<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PlatformManager.Business.Application</RootNamespace>
    <AssemblyName>PlatformManager.Business.Application</AssemblyName>
  </PropertyGroup>

  <!-- MediatR + FluentValidation: cùng bộ, cùng version với Core.Application — mỗi tầng tự
       đăng ký handler/validator của assembly MÌNH (DependencyInjection.cs), còn 2 pipeline
       behavior dùng chung thì CHỈ Core.Application đăng ký (xem docstring ở đó). -->
  <!-- Mở internal cho bộ unit test của CHÍNH tầng này: AssessmentPayloadMapper là chi tiết thi
       công (dịch payload đường dây → luật ghi), không phải API công khai, nhưng nó là chỗ luật Q74
       có thể vỡ mà không ai thấy — nên nó cần test đi qua CHÍNH nó thay vì một bản dựng tay.
       Không mở cho assembly sản phẩm nào. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PlatformManager.Business.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
  </ItemGroup>

  <!-- Đúng ba cạnh đã khai: Business.Application → Core.Application, Core.Domain,
       Business.Domain. TUYỆT ĐỐI KHÔNG reference *.Persistence / *.Infrastructure — canh bằng
       máy ở ApplicationLayerBoundaryTests (cả mức assembly lẫn mức .csproj). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Domain\PlatformManager.Core.Domain.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Application\PlatformManager.Core.Application.csproj" />
    <ProjectReference Include="..\PlatformManager.Business.Domain\PlatformManager.Business.Domain.csproj" />
  </ItemGroup>

</Project>

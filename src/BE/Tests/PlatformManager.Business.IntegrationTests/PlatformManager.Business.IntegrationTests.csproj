<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PlatformManager.Business.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <!-- Integration test của TẦNG NGHIỆP VỤ, tách khỏi PlatformManager.Core.IntegrationTests cùng
       lý do đã ghi ở PlatformManager.Business.UnitTests.csproj: bộ test Core phải chạy được
       nguyên vẹn khi CoreBase tách sang dự án thứ hai, mà dự án đó không có entity DTI nào.

       Phạm vi: những thứ CHỈ Postgres thật mới trả lời được — EF dịch LINQ sang SQL, ràng buộc
       unique partial, CHECK constraint, và bất biến "một chỗ lọc, hai phép Select" của Q68.
       Phần logic thuần thuộc Business.UnitTests. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Postgres THẬT trong container — TUYỆT ĐỐI không UseInMemoryDatabase. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <!-- Ghim tường minh, cùng lý do và cùng phiên bản với Core.IntegrationTests.csproj:
         Testcontainers 4.1.0 kéo transitively SSH.NET 2024.1.0 dính NU1903. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Domain\PlatformManager.Business.Domain.csproj" />
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Application\PlatformManager.Business.Application.csproj" />
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Persistence\PlatformManager.Business.Persistence.csproj" />
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Infrastructure\PlatformManager.Business.Infrastructure.csproj" />

    <!-- Host thật — cần cho WebApplicationFactory<Program> và cho HostModuleRegistrars. Chỉ test
         project mới được tham chiếu Api; ranh giới Core/Business vẫn do ArchTests canh. -->
    <ProjectReference Include="..\..\PlatformManager.Api\PlatformManager.Api.csproj" />

    <!-- Dùng LẠI PostgresFixture của bộ Core thay vì chép một bản thứ hai: nó là nơi DUY NHẤT biết
         danh sách script schema, và một bản sao sẽ lệch ngay lần thêm file .sql kế tiếp — đúng
         kiểu hỏng mà chính fixture đó sinh ra để chặn.
         ⚠️ Cạnh này biến mất cùng lúc với cả project này khi CoreBase tách ra, nên nó KHÔNG phải
         một phụ thuộc Core → Business (chiều ngược lại mới là thứ bị cấm). -->
    <ProjectReference Include="..\PlatformManager.Core.IntegrationTests\PlatformManager.Core.IntegrationTests.csproj" />
  </ItemGroup>

</Project>

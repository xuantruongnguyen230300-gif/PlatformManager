<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PlatformManager.Core.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <!-- Bộ test NGHIỆP VỤ dùng lại hạ tầng test ở đây: PostgresFixture (public, KẾ THỪA ĐƯỢC) và
       IntegrationTestHostEnvironment (internal). Mở internal cho ĐÚNG một assembly thay vì đổi lớp
       kia thành public — nó là hạ tầng của CÂY TEST, không phải API để bất kỳ ai dùng, và giữ
       internal là cách nói ra điều đó.

       ✅ Cạnh này VÔ HẠI với lượt tách CoreBase (làm rõ 2026-09-11 sau finding F5): InternalsVisibleTo
       trỏ một assembly KHÔNG TỒN TẠI cũng không gây lỗi biên dịch lẫn lỗi chạy — nó chỉ là một
       attribute không ai khớp. Gỡ cây src/BE/Business/ đi thì dòng này nằm im, vô hại.

       🛑 Cạnh NGUY HIỂM là một cạnh KHÁC, và nó đã bị gỡ: bản đầu của lượt 2026-09-11 khai cứng ba
       file .sql của Business.Persistence vào chính PostgresFixture. Cạnh đó KHÔNG tự biến mất khi
       gỡ cây Business — nó làm toàn bộ collection chết ở InitializeAsync. Nay danh sách script
       nghiệp vụ sống ở BusinessPostgresFixture.ExtraScripts, tức chết cùng project của nó.
       Phép thử: xoá src/BE/Business/ thì project NÀY phải vẫn biên dịch và chạy nguyên vẹn. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PlatformManager.Business.IntegrationTests" />
  </ItemGroup>

  <!-- PlatformManagerDbContext kế thừa IdentityDbContext → cần shared framework ASP.NET Core. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Postgres THẬT trong container — TUYỆT ĐỐI không UseInMemoryDatabase (bỏ qua FK/unique
         index/transaction thật), xem doc/huong_dan/wiki-core/be/04-testing-strategy.md. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <!-- Ghim tường minh — Testcontainers 4.1.0 kéo transitively SSH.NET 2024.1.0, dính NU1903
         (high severity, GHSA-q939-rpr3-3284 / CVE-2026-48798 — path traversal khi ScpClient tải
         thư mục đệ quy). Advisory ghi vulnerable range "<= 2025.1.0", first patched 2026.0.0:
         2024.2.0 và 2025.x KHÔNG đủ (đã thử 2024.2.0, cảnh báo vẫn còn). Cùng khuôn với 2 lần
         ghim trước (Newtonsoft.Json ở Core.Infrastructure.csproj, và một lần ở module nghiệp
         vụ nay đã xoá): ghim bản VÁ THẤP NHẤT, đặt ngay cạnh package kéo nó vào. Gỡ được khi Testcontainers tự nâng. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Phải khớp version Npgsql mà Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 kéo theo —
         khai thấp hơn sẽ thành package downgrade (NU1605, đang bật WarningsAsError). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- WebApplicationFactory<Program> — chạy ĐÚNG host PlatformManager.Api thật (cookie
         middleware + SecurityStampValidator do AddIdentity nối vào), không phải host mô phỏng.
         Version khớp shared framework Microsoft.AspNetCore.App 10.0.11 đang cài. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Domain\PlatformManager.Core.Domain.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Application\PlatformManager.Core.Application.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Persistence\PlatformManager.Core.Persistence.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Infrastructure\PlatformManager.Core.Infrastructure.csproj" />
    <!-- Host thật — cần cho WebApplicationFactory<Program>. Chỉ test project mới được tham chiếu
         Api; ranh giới Core/Modules vẫn do ArchTests canh (xem CoreModuleBoundaryTests). -->
    <ProjectReference Include="..\..\PlatformManager.Api\PlatformManager.Api.csproj" />
  </ItemGroup>

</Project>

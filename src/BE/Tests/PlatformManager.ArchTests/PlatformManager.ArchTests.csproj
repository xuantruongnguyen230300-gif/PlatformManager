<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PlatformManager.ArchTests</RootNamespace>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Dùng trực tiếp API MediatR/FluentValidation trong test (dựng mini pipeline) — cùng
         version với PlatformManager.Core.Application.csproj, dù vốn đã có transitive qua
         ProjectReference. -->
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <!-- Microsoft.Extensions.DependencyInjection KHÔNG khai ở đây: từ 2026-09-01 project này có
         FrameworkReference Microsoft.AspNetCore.App (xem ItemGroup cuối file), nên gói đó do
         shared framework cung cấp — khai lại sinh NU1510 (WarningsAsErrors chưa bật cho nó,
         nhưng mốc nghiệm thu của repo là 0 cảnh báo). -->
  </ItemGroup>

  <!-- ArchTests là NGOẠI LỆ có chủ đích — tham chiếu ĐỦ MỌI project (kể cả Infrastructure)
       để có thể reflection-kiểm tra ranh giới Core↔Modules ở MỌI tầng (kể cả tầng dễ vi phạm
       nhất trong thực tế: Core.Infrastructure lỡ tay reference Modules.Infrastructure). Dựng
       module nghiệp vụ mới thì thêm cả 3 project của nó vào ItemGroup dưới. Đây
       KHÔNG vi phạm luật "chỉ Api được biết Infrastructure" — luật đó áp cho project SẢN PHẨM,
       test project luôn được phép thấy toàn bộ để kiểm tra chéo. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Domain\PlatformManager.Core.Domain.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Application\PlatformManager.Core.Application.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Persistence\PlatformManager.Core.Persistence.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Infrastructure\PlatformManager.Core.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Core\PlatformManager.Core.Api\PlatformManager.Core.Api.csproj" />
    <!-- Thêm 2026-09-01 cùng 4 ArchTest "sự TỒN TẠI / sự ĐƯỢC NỐI VÀO". Bắt buộc phải có, vì 2
         thành phần mà chúng canh chỉ sống ở Api: 3 middleware trong Api/Common, và
         CorsPolicyOptions — chính là Options đã gây sự cố 2026-08-31 (deploy xanh, app chặn sạch
         người dùng). Không reference Api thì test bỏ sót đúng ca thúc đẩy nó ra đời.
         Middleware là internal, nhưng Assembly.GetTypes() vẫn thấy — KHÔNG cần InternalsVisibleTo
         (và vì thế ArchTests không cần Mvc.Testing như IntegrationTests). -->
    <ProjectReference Include="..\..\PlatformManager.Api\PlatformManager.Api.csproj" />
    <!-- Tầng nghiệp vụ (thêm 2026-09-10). Đủ CẢ NĂM project — ProductAssemblies.All nạp assembly
         qua typeof, nên thiếu một project ở đây là assembly đó lặng lẽ rơi khỏi phạm vi của 7 luật
         reflection, không test nào đỏ. Api reference bắc cầu tới cả năm, nhưng khai tường minh để
         đồ thị đọc được ngay trong .csproj. -->
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Domain\PlatformManager.Business.Domain.csproj" />
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Application\PlatformManager.Business.Application.csproj" />
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Persistence\PlatformManager.Business.Persistence.csproj" />
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Infrastructure\PlatformManager.Business.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Business\PlatformManager.Business.Api\PlatformManager.Business.Api.csproj" />
  </ItemGroup>

  <!-- Kiểu của Api và của Core.Persistence (IdentityDbContext) chạm shared framework ASP.NET
       Core — khai tường minh, cùng lý do đã ghi ở PlatformManager.Core.IntegrationTests.csproj. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

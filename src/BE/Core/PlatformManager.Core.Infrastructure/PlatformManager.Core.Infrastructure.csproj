<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PlatformManager.Core.Infrastructure</RootNamespace>
    <AssemblyName>PlatformManager.Core.Infrastructure</AssemblyName>
  </PropertyGroup>

  <!-- Infrastructure là classlib (Microsoft.NET.Sdk) nhưng cần đủ API ASP.NET Core Identity
       (UserManager/RoleManager/SignInManager/AddIdentity/AddCookie) — FrameworkReference
       cho phép 1 classlib dùng shared framework Microsoft.AspNetCore.App mà KHÔNG cần đổi
       sang Microsoft.NET.Sdk.Web (không có Kestrel/entry point nào ở đây, chỉ dùng API).
       Đây là pattern chuẩn cho Infrastructure layer cần Identity trong Clean Architecture. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlatformManager.Core.Application\PlatformManager.Core.Application.csproj" />
    <ProjectReference Include="..\PlatformManager.Core.Domain\PlatformManager.Core.Domain.csproj" />
  </ItemGroup>

</Project>

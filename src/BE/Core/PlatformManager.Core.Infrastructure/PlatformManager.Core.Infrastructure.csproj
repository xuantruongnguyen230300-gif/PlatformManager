<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PlatformManager.Core.Infrastructure</RootNamespace>
    <AssemblyName>PlatformManager.Core.Infrastructure</AssemblyName>
    <!-- NPOI bundle định dạng OOXML theo giấy phép OSMF riêng (khác Apache 2.0 của chính NPOI) —
         chấp nhận tường minh để build không cảnh báo, đọc kỹ trước khi đổi:
         https://github.com/nissl-lab/npoi/blob/master/OSMFEULA.txt -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <!-- Infrastructure là classlib (Microsoft.NET.Sdk) nhưng cần đủ API ASP.NET Core Identity
       (UserManager/RoleManager/SignInManager/AddIdentity/AddCookie) — FrameworkReference
       cho phép 1 classlib dùng shared framework Microsoft.AspNetCore.App mà KHÔNG cần đổi
       sang Microsoft.NET.Sdk.Web (không có Kestrel/entry point nào ở đây, chỉ dùng API).
       Đây là pattern chuẩn cho Infrastructure layer cần Identity trong Clean Architecture. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <!-- Chặn mật khẩu phổ biến ngay lúc đặt (chốt 2026-08-31, xem
         doc/huong_dan/wiki-core/be/09-security-beyond-auth.md §"Chính sách mật khẩu"). Danh sách
         top 10.000 NHÚNG SẴN trong assembly ⇒ chạy offline, KHÔNG gọi API ra Internet lúc chạy.
         Đăng ký ở DependencyInjection.cs qua .AddTop10000PasswordValidator<AppUser>(). -->
    <PackageReference Include="CommonPasswordsValidator" Version="1.5.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Hangfire.Core: HangfireBackgroundJobScheduler — hiện thực seam IBackgroundJobScheduler
         (khai ở Core.Application). Chỉ TẦNG NÀY được biết tới Hangfire; *.Application KHÔNG
         reference Hangfire (ArchTest LayerDependencyTests cưỡng chế). Server/Dashboard/
         PostgreSql storage vẫn chỉ cần ở PlatformManager.Api (composition root). Xem
         doc/huong_dan/quy-uoc/be-cqrs-handler.md §"Command chạy lâu → job nền". -->
    <PackageReference Include="Hangfire.Core" Version="1.8.24" />
    <!-- Ghim tường minh — Hangfire.Core 1.8.24 kéo transitively Newtonsoft.Json 11.0.1, dính
         NU1903 (high severity). Bản 13.0.4 không còn cảnh báo. Ghim đi CÙNG Hangfire.Core:
         trước 2026-08-28 nó nằm ở Modules.DtiWeekly.Application.csproj, chuyển sang đây cùng
         lượt tách seam. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Import engine (Import/): CsvHelper cho .csv, NPOI cho .xlsx (XSSF) lẫn .xls (HSSF).
         CHỈ tầng này được biết tới hai thư viện đó — seam IImportFileReader ở Core.Application
         phải sạch thư viện, và LayerDependencyTests cưỡng chế. NPOI là lựa chọn bắt buộc nếu muốn
         đọc .xls: ClosedXML/EPPlus chỉ đọc được .xlsx. Xem
         doc/huong_dan/wiki-core/be/15-import-export.md §2. -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <!-- ⚠️ KHÔNG ghim System.Security.Cryptography.Xml ở đây, dù module cũ từng phải ghim:
         NPOI 2.8.0 kéo transitively bản 8.0.2 (dính NU1903), nhưng trên net10.0 gói đó thuộc
         framework nên SDK tự nâng — ghim tường minh chỉ đổi NU1903 thành NU1510
         ("will not be pruned… Remove the PackageReference item"). Đo lại nếu đổi TFM. -->

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlatformManager.Core.Application\PlatformManager.Core.Application.csproj" />
    <ProjectReference Include="..\PlatformManager.Core.Domain\PlatformManager.Core.Domain.csproj" />
    <!-- Core.Persistence (tách ra 2026-09-10): Infrastructure cần kiểu AppUser/AppRole và
         PlatformManagerDbContext để dựng UserManager/SignInManager và đăng ký DbContext trong
         AddCoreModule. Chiều ngược lại bị cấm — xem doc/kien-truc-core-module.md
         §"Nguyên tắc phụ thuộc bắt buộc". -->
    <ProjectReference Include="..\PlatformManager.Core.Persistence\PlatformManager.Core.Persistence.csproj" />
  </ItemGroup>

</Project>
